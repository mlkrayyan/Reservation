{"nodes": [{"id": "icons_sprite", "label": "Icon Sprite Sheet (icons.svg)", "file_type": "image", "source_file": "frontend/public/icons.svg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A 6-symbol SVG sprite defining ONLY developer/community affordances (bluesky, discord, documentation, github, social, x) with Vite-purple #aa3bff strokes. It contains no booking, calendar, staff, service, loyalty or payment iconography, and no source file under frontend/ references it - a grep for 'icons.svg' across ts/tsx/html/css/json returns zero hits. It is the Vite React starter landing-page sprite left behind by the scaffold, not the product's UI icon system."}, {"id": "icons_bluesky_icon", "label": "bluesky-icon symbol", "file_type": "image", "source_file": "frontend/public/icons.svg", "source_location": "symbol#bluesky-icon", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "icons_bluesky_clip", "label": "bluesky-clip clipPath", "file_type": "image", "source_file": "frontend/public/icons.svg", "source_location": "clipPath#bluesky-clip", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Support definition only - a rectangular clip region consumed by bluesky-icon via clip-path=url(#bluesky-clip); carries no product meaning."}, {"id": "icons_discord_icon", "label": "discord-icon symbol", "file_type": "image", "source_file": "frontend/public/icons.svg", "source_location": "symbol#discord-icon", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "icons_documentation_icon", "label": "documentation-icon symbol", "file_type": "image", "source_file": "frontend/public/icons.svg", "source_location": "symbol#documentation-icon", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stroked outline of a document with angle-bracket/code marks - reads as 'read the docs', a developer affordance rather than an end-user spa feature."}, {"id": "icons_github_icon", "label": "github-icon symbol", "file_type": "image", "source_file": "frontend/public/icons.svg", "source_location": "symbol#github-icon", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "icons_social_icon", "label": "social-icon symbol", "file_type": "image", "source_file": "frontend/public/icons.svg", "source_location": "symbol#social-icon", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A person silhouette with a star badge. Shape-wise it is the closest thing in the sprite to a customer/profile or review/rating affordance, but in the Vite starter it labels the 'join the community' link group - the product reading is unverified."}, {"id": "icons_x_icon", "label": "x-icon symbol", "file_type": "image", "source_file": "frontend/public/icons.svg", "source_location": "symbol#x-icon", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_community_social_links", "label": "Community / Social Link Affordances", "file_type": "rationale", "source_file": "frontend/public/icons.svg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bluesky, Discord, GitHub, X and the person+star glyph together form an outbound social/community link cluster - the affordance set of a framework landing page. A spa booking product would plausibly want Instagram/Facebook/WhatsApp instead, so even if these were adopted they are the wrong social surface."}, {"id": "concept_developer_documentation_link", "label": "Developer Documentation Link", "file_type": "rationale", "source_file": "frontend/public/icons.svg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "documentation-icon points at framework docs, an affordance for developers rather than for salon customers or staff."}, {"id": "concept_booking_ui_iconography", "label": "Booking / Scheduling UI Iconography (absent)", "file_type": "rationale", "source_file": "frontend/public/icons.svg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Recorded as a negative finding: the sprite defines no calendar, clock, scissors, staff, service, loyalty-points, waitlist or payment symbol. Whatever iconography the booking flow, staff scheduler, customer portal and admin dashboard use must come from an icon library or inline JSX elsewhere in frontend/src, not from this sprite. Any edge asserting icons.svg serves a product flow is unverified and marked AMBIGUOUS."}], "edges": [{"source": "icons_sprite", "target": "icons_bluesky_icon", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "frontend/public/icons.svg", "source_location": "symbol#bluesky-icon", "weight": 1.0}, {"source": "icons_sprite", "target": "icons_discord_icon", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "frontend/public/icons.svg", "source_location": "symbol#discord-icon", "weight": 1.0}, {"source": "icons_sprite", "target": "icons_documentation_icon", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "frontend/public/icons.svg", "source_location": "symbol#documentation-icon", "weight": 1.0}, {"source": "icons_sprite", "target": "icons_github_icon", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "frontend/public/icons.svg", "source_location": "symbol#github-icon", "weight": 1.0}, {"source": "icons_sprite", "target": "icons_social_icon", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "frontend/public/icons.svg", "source_location": "symbol#social-icon", "weight": 1.0}, {"source": "icons_sprite", "target": "icons_x_icon", "r