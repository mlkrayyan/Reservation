{"nodes": [{"id": "dependencyinjection_AddInfrastructure", "label": "AddInfrastructure DI Extension", "file_type": "code", "source_file": "src/SpaReservation.Infrastructure/DependencyInjection.cs", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "dependencyinjection_addinfrastructure", "label": "AddInfrastructure Composition Root", "file_type": "code", "source_file": "src/SpaReservation.Infrastructure/DependencyInjection.cs", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Single extension method acts as the Infrastructure composition root so the API project never references concrete repositories, preserving the Clean Architecture dependency rule."}, {"id": "dependencyinjection_inmemory_persistence", "label": "EF Core In-Memory Database Provider", "file_type": "rationale", "source_file": "src/SpaReservation.Infrastructure/DependencyInjection.cs", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "UseInMemoryDatabase(\"SpaReservationDb\") chosen so the app runs with zero external database setup; data is volatile per process, which is why DbSeeder must re-seed on every startup and why relational features (precision, cascade, owned columns) are configured but never actually enforced."}, {"id": "dependencyinjection_hangfire_inmemory_storage", "label": "Hangfire In-Memory Storage and Server", "file_type": "rationale", "source_file": "src/SpaReservation.Infrastructure/DependencyInjection.cs", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hangfire configured with UseInMemoryStorage plus AddHangfireServer, so the job scheduler is in-process and job history dies with the process; matches the demo posture of the EF in-memory provider but means recurring jobs are re-registered at each boot."}, {"id": "dependencyinjection_scoped_lifetime", "label": "Scoped Repository and UnitOfWork Lifetime", "file_type": "rationale", "source_file": "src/SpaReservation.Infrastructure/DependencyInjection.cs", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every repository, IUnitOfWork and IBookingReminderJob registered AddScoped so they share one ApplicationDbContext change-tracker per request/job scope; Hangfire jobs must therefore run inside an explicit service scope."}, {"id": "hangfire_recurring_schedule", "label": "Hangfire Recurring Job Schedule (24h / 1h / waitlist)", "file_type": "rationale", "source_file": "src/SpaReservation.Infrastructure/DependencyInjection.cs", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Jobs are bound to IBookingReminderJob by interface (not concrete class) so Hangfire resolves them from DI per execution: reminder-24h daily, reminder-1h hourly, waitlist-expire daily. The recurrence itself is declared at API startup, not in Infrastructure."}], "edges": [{"source": "bookingrepository_bookingrepository", "target": "ibookingrepository_ibookingrepository", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/SpaReservation.Infrastructure/DependencyInjection.cs", "source_location": null, "weight": 1.0}, {"source": "customerrepository_customerrepository", "target": "icustomerrepository_icustomerrepository", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/SpaReservation.Infrastructure/DependencyInjection.cs", "source_location": null, "weight": 1.0}, {"source": "salonservicerepository_salonservicerepository", "target": "isalonservicerepository_isalonservicerepository", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/SpaReservation.Infrastructure/DependencyInjection.cs", "source_location":