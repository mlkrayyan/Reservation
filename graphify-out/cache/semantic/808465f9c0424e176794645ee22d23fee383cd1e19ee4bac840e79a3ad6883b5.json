{"nodes": [{"id": "unitofwork_unitofwork", "label": "UnitOfWork", "file_type": "code", "source_file": "src/SpaReservation.Infrastructure/Repositories/UnitOfWork.cs", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "unitofwork_UnitOfWork", "label": "UnitOfWork (EF SaveChanges wrapper)", "file_type": "code", "source_file": "src/SpaReservation.Infrastructure/Repositories/UnitOfWork.cs", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Thin delegation to DbContext.SaveChangesAsync only. It opens no explicit transaction (relying on EF's implicit per-SaveChanges transaction) and performs NO domain-event dispatch, even though AggregateRoot collects domain events - so events raised by aggregates are never published from the persistence boundary."}, {"id": "unitofwork_SaveChangesAsync", "label": "UnitOfWork.SaveChangesAsync", "file_type": "code", "source_file": "src/SpaReservation.Infrastructure/Repositories/UnitOfWork.cs", "source_location": "14-17", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_UnitOfWorkSaveSemantics", "label": "Unit-of-Work Save Semantics", "file_type": "rationale", "source_file": "src/SpaReservation.Infrastructure/Repositories/UnitOfWork.cs", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Repositories never call SaveChanges themselves - they only stage changes on the tracked DbContext, and a single UnitOfWork.SaveChangesAsync at the end of a use case commits them atomically in EF's implicit transaction. No explicit BeginTransaction and no domain-event dispatch hook exist."}], "edges": [{"source": "unitofwork_UnitOfWork", "target": "iunitofwork_IUnitOfWork", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/SpaReservation.Infrastructure/Repositories/UnitOfWork.c