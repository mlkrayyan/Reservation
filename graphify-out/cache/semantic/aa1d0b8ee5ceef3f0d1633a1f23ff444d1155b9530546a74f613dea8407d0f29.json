{"nodes": [{"id": "customer_Customer", "label": "Customer Aggregate", "file_type": "code", "source_file": "src/SpaReservation.Domain/Customers/Customer.cs", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "customer_Customer", "label": "Customer (aggregate root)", "file_type": "code", "source_file": "src/SpaReservation.Domain/Customers/Customer.cs", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Owns its LoyaltyTransaction collection behind a private backing list exposed as IReadOnlyList, so the running LoyaltyPoints balance and the ledger can only ever move together."}, {"id": "customer_LoyaltyPointsLedger", "label": "Loyalty points mechanics (balance plus signed ledger)", "file_type": "rationale", "source_file": "src/SpaReservation.Domain/Customers/Customer.cs", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "AwardLoyaltyPoints adds a positive PointsDelta row and DeductLoyaltyPoints adds the negated value, so the denormalized LoyaltyPoints running total should always equal the sum of the ledger. The only invariant guarded is non-negative balance on deduction (throws on insufficient points); awards accept any value, including zero or negative."}, {"id": "customer_ExternalAuthIdentity", "label": "External identity mapping (ExternalAuthId + AuthProvider)", "file_type": "rationale", "source_file": "src/SpaReservation.Domain/Customers/Customer.cs", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Customer holds no password: identity is a (provider, external id) pair set at creation and never updated by UpdateProfile, so authentication stays entirely outside the domain."}, {"id": "customer_Customer", "label": "Customer aggregate root", "file_type": "code", "source_file": "src/SpaReservation.Domain/Customer